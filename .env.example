# MarginPilot — Environment Variables (TEMPLATE)
# Copy this file to `.env` and replace every placeholder.
# NEVER commit the real `.env`. Every value below is a placeholder —
# no real secret is stored in this repository.

# --- Application ---
APP_ENV=development                    # development | staging | production
# Port 3000 is fixed: Vite dev server runs with strictPort (frontend/
# vite.config.ts) so it never silently moves to another port.
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
# APP_SECRET removed (final review): no v1 component consumes it — v1 uses no JWT
# and password reset uses random one-time tokens hashed in DB. Re-add only when
# a real consumer exists.

# --- Database (PostgreSQL) ---
# P1-02: ONLY the postgresql+psycopg:// scheme is accepted. The backend
# rejects plain postgresql:// at startup — SQLAlchemy would fall back to the
# psycopg2 DBAPI, changing the driver family behind the configuration.
DATABASE_URL=postgresql+psycopg://marginpilot:change-me@localhost:5432/marginpilot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Docker Compose (docker-compose.yml reads these from .env) ---
# Used to build the container DATABASE_URL and to initialize the postgres
# container. NEVER commit the real .env with the real password.
#
# P2-04 URL-SAFETY CONSTRAINT: the container DATABASE_URL is built by string
# interpolation (`postgresql+psycopg://$USER:$PASSWORD@postgres:5432/$DB`),
# so POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB must be URL-safe:
# ASCII letters, digits and `-_.~` ONLY. No `@ : / ? # % & = + space` —
# such characters would corrupt the URL.
# Safe generation (192-bit entropy, hex output is URL-safe):
#   PowerShell:
#     $b=[byte[]]::new(24); [Security.Cryptography.RandomNumberGenerator]::Fill($b); ($b|%{$_.ToString('x2')}) -join ''
#   bash:  openssl rand -hex 24
POSTGRES_USER=marginpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=marginpilot

# --- Sessions ---
SESSION_IDLE_TIMEOUT_MINUTES=10080      # 7 days idle timeout
SESSION_ABSOLUTE_TIMEOUT_MINUTES=43200  # 30 days absolute timeout
SESSION_COOKIE_NAME=mp_session
SESSION_COOKIE_SECURE=true              # must be true in production (HTTPS only)
SESSION_COOKIE_SAMESITE=lax             # lax | strict

# --- CSRF ---
# No CSRF cookie: the session-bound CSRF token is delivered via the
# X-CSRF-Token response header (see docs/security.md §2).

# --- CORS / Frontend ---
CORS_ORIGINS=http://localhost:3000

# --- Rate limiting (in-process in v1; Redis-ready) ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=3         # registration abuse protection (per IP)
RATE_LIMIT_GLOBAL_PER_MINUTE=300
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=15

# --- Registration / Tenancy governance ---
ALLOW_REGISTRATION=true                # set false to close public sign-up
MAX_TENANTS_PER_USER=5

# --- Idempotency ---
IDEMPOTENCY_TTL_HOURS=24               # retention of stored idempotency results

# --- Audit ---
AUDIT_RETENTION_DAYS=400               # minimum retention for audit_logs

# --- Upload / Import limits ---
UPLOAD_MAX_MB=25
IMPORT_MAX_ROWS=100000

# --- Money ---
# IRT = Toman, IRR = Rial. Currency is set per tenant and is NEVER
# converted implicitly. minor units for both = 0.
DEFAULT_CURRENCY=IRT

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json                         # json | console
TZ=Asia/Tehran
